<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.jokoframework</groupId>
  <artifactId>joko-utils</artifactId>
  <name>joko-utils</name>
  <version>0.6.9</version>
  <url>http://maven.apache.org</url>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.2.4</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>io.github.jokoframework.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.github.jokoframework.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.0.0-M3</version>
        <executions>
          <execution>
            <id>enforce-maven-3</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>3.1.0</version>
                </requireMavenVersion>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
        <inherited>true</inherited>
      </plugin>
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>${dependency-check.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <failBuildOnCVSS>8</failBuildOnCVSS>
          <suppressionFiles>dependency-check-suppressions.xml</suppressionFiles>
          <format>HTML</format>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.1</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>hamcrest-core</artifactId>
          <groupId>org.hamcrest</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub jokoframework Apache Maven Packages</name>
      <url>https://maven.pkg.github.com/jokoframework/joko-utils</url>
    </repository>
  </distributionManagement>
  <properties>
    <pdfbox.version>2.0.24</pdfbox.version>
    <slf4j-simple.version>1.7.30</slf4j-simple.version>
    <java.version>11</java.version>
    <maven.compiler.source>11</maven.compiler.source>
    <orika-core.version>1.5.4</orika-core.version>
    <javax.xml.bind.version>2.4.0-b180830.0359</javax.xml.bind.version>
    <slf4j-api.version>1.7.30</slf4j-api.version>
    <guava.version>32.0.0-jre</guava.version>
    <commons-beanutils.version>1.9.4</commons-beanutils.version>
    <jaxb-api.version>2.4.0-b180830.0359</jaxb-api.version>
    <opencsv.version>5.7.1</opencsv.version>
    <maven.compiler.target>11</maven.compiler.target>
    <dependency-check.version>8.4.0</dependency-check.version>
    <spring-security-crypto.version>5.8.7</spring-security-crypto.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <commons-lang3.version>3.11</commons-lang3.version>
    <boxable.version>1.6</boxable.version>
    <joda-time.version>2.10.6</joda-time.version>
    <junit.version>4.13.1</junit.version>
    <commons-codec.version>1.15</commons-codec.version>
    <poi-ooxml.version>4.1.2</poi-ooxml.version>
    <commons-io.version>2.8.0</commons-io.version>
    <spring-beans.version>5.3.24</spring-beans.version>
  </properties>
</project>
